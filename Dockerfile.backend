# ==========================================
# Multi-Stage High-Performance Rust Container
# ==========================================
FROM rust:1.80-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests for cache layering
COPY backend/Cargo.toml backend/Cargo.lock* ./
RUN mkdir src tests && \
    echo "fn main() {}" > src/main.rs && \
    echo "pub fn dummy() {}" > src/lib.rs && \
    cargo build --release && \
    rm -rf src tests

# Copy actual source code
COPY backend/src ./src
COPY backend/tests ./tests

# Build optimized release binary
RUN touch src/main.rs src/lib.rs && cargo build --release

# ==========================================
# Minimal Distroless/Slim Production Runtime
# ==========================================
FROM debian:bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/streamflow-backend /usr/local/bin/streamflow-backend

ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8080
ENV DATABASE_URL=sqlite:///app/data/streamflow.db?mode=rwc
ENV SEGMENT_CACHE_MB=64

RUN mkdir -p /app/data

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

ENTRYPOINT ["/usr/local/bin/streamflow-backend"]
