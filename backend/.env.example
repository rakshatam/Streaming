# StreamFlow Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_URL=sqlite://streamflow.db?mode=rwc
HMAC_SECRET=replace-with-random-32-byte-secret
JWT_SECRET=replace-with-a-different-random-32-byte-secret
# Optional. Required only to clear the in-memory cache through the admin endpoint.
CACHE_ADMIN_TOKEN=
# Set this to the browser-facing frontend origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEGMENT_CACHE_MB=64
TOKEN_VALIDITY_SECS=3600

# Optional outbound email configuration. Registration currently does not use SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=StreamFlow Security <noreply@streamflow.tv>
