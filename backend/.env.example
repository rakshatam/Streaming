# StreamFlow High-Throughput Streaming Engine Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=sqlite://streamflow.db?mode=rwc
HMAC_SECRET=netflix_level_streamflow_ultra_secure_hmac_secret_key_2026
JWT_SECRET=streamflow_jwt_secret_token_signing_key_super_secure
SEGMENT_CACHE_MB=256
TOKEN_VALIDITY_SECS=3600

# ==========================================
# Real SMTP Email Delivery Configuration (Optional)
# ==========================================
# If configured, StreamFlow will deliver live OTP codes directly to user inboxes.
# If not configured, StreamFlow operates in development fallback mode with one-click on-screen OTP.
#
# Examples for Common Providers:
#
# 1. Gmail (Requires 16-character Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=StreamFlow Security <your_email@gmail.com>
#
# 2. Resend / SendGrid / Brevo / Mailgun / AWS SES:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_1234567890
# SMTP_FROM=StreamFlow Security <onboarding@yourdomain.com>
#
# Uncomment and configure below to enable live email delivery:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=StreamFlow Security <noreply@streamflow.tv>
